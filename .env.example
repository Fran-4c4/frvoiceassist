# Copy this file to .env and adjust it as needed. All variables are optional.

# Host port (http://localhost:8765)
PORT=8765

# Personal data directory (voices, presentations, and audio). Default: ~/frvoiceassist
# FRVOICEASSIST_HOME=D:/Data/frvoiceassist

# Engine: qwen (GPU) | fake (synthetic tone for testing the UI without a GPU)
TTS_ENGINE=qwen

# Supported Base models: 1.7B (default, higher capacity) or 0.6B (lower resource use and good quality)
TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-Base
# TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-Base

TTS_DEVICE=cuda:0
TTS_DTYPE=bfloat16

# Attention: sdpa (default) | flash_attention_2 (requires INSTALL_FLASH_ATTN=true at build time) | eager
TTS_ATTN=sdpa
INSTALL_FLASH_ATTN=false

TTS_LANGUAGE=English
TTS_DEFAULT_VOICE=me

# Long texts: split into TTS_CHUNK_CHARS chunks and join them with TTS_PAUSE_MS of silence
TTS_MAX_TEXT_CHARS=5000
TTS_CHUNK_CHARS=300
TTS_PAUSE_MS=250
TTS_MAX_NEW_TOKENS=2048

# Save audio generated in "Free text" under ~/frvoiceassist/outputs
TTS_SAVE_OUTPUTS=true

# Reference-voice quality check with Whisper (whisper | none).
# Use a multilingual model for English or Spanish references. CPU avoids competing with Qwen for VRAM.
QUALITY_STT=whisper
STT_MODEL=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8

# Only when Hugging Face limits anonymous downloads
# HF_TOKEN=hf_xxx
